# Siri identity used to scope semantic memory.
SIRI_USER_ID=siri_user

# Groq API configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Required together to enable real semantic memory.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=aisaftey
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=1024

# Optional local location for full fact records and pending summaries.
SEMANTIC_MEMORY_DATA_DIR=memory_data

# Optional logging level for safe memory metrics.
LOG_LEVEL=INFO
